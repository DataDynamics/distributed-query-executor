{# query-count 예제 — 고객 정보를 붙인 주문을 지역 IN 목록·주문일 구간·고객 등급으로 거른다.
   coordinator 가 이 SELECT 를 COUNT(*) 서브쿼리로 감싸므로, 두 테이블에 모두 있는
   customer_id·region 은 별칭(cust_region)을 붙이거나 한쪽만 골라 출력 컬럼 이름이 겹치지
   않게 한다. 파라미터는 반드시 필터를 거쳐 안전한 리터럴로 렌더한다(SQL 인젝션 방지):
     - regions            → sql_in  (콤마 구분 리터럴 목록, 빈 목록은 안전한 NULL)
     - start_dt / end_dt  → sql_str (작은따옴표 이스케이프한 날짜 문자열 리터럴)
     - grade              → sql_str (값이 있을 때만 조건을 붙인다)
   ORDER BY 는 건수에 영향이 없고 정렬 비용만 더하므로 두지 않는다. #}
SELECT o.order_id,
       o.customer_id,
       o.region,
       o.order_dt,
       o.amount,
       c.grade,
       c.region AS cust_region
FROM orders o
JOIN customers c ON c.customer_id = o.customer_id
WHERE o.region IN ( {{ regions | sql_in }} )
  AND o.order_dt BETWEEN {{ start_dt | sql_str }} AND {{ end_dt | sql_str }}
{%- if grade %}
  AND c.grade = {{ grade | sql_str }}
{%- endif %}
