{# 외부테이블(=staging) → target 적재 INSERT. s3_stage 에서 executor 가 PXF 외부테이블을
   생성한 뒤 이 INSERT 를 실행한다(외부테이블이 staging 역할을 겸한다). staging_table 이름은
   coordinator 가 task 마다 task_id 접미사로 고유화하고, 같은 이름이 여기서도 치환된다.
   테이블명은 따옴표 없이 bare 로 렌더한다. #}
INSERT INTO {{ target_table }} (user_id, amount, region, dt)
SELECT user_id, amount, region, dt
FROM {{ staging_table }}
