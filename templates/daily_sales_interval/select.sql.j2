{# 상대 일수 interval 로 구간을 잡는 SELECT.
   interval 뒤에는 절대값만 올 수 있으므로 방향은 값이 아니라 **연산자**로 나간다 —
   from_date_no_sign / to_date_no_sign 이 그 자리(+/-)이고 sql_sign 이 두 토큰 외에는 막는다.
   fan-out 이면 coordinator 가 task 마다 두 파라미터를 같은 날로 좁혀(값=|오프셋|, 부호=방향)
   렌더하므로 BETWEEN 이 하루로 붕괴한다. fan-out 이 아니면 요청이 보낸 값·부호 그대로
   구간 전체를 읽는다. #}
SELECT user_id, amount, region, dt
FROM sales
WHERE dt BETWEEN trunc(current_date() {{ from_date_no_sign | sql_sign }} interval {{ from_date_no | sql_num }} day)
             AND trunc(current_date() {{ to_date_no_sign   | sql_sign }} interval {{ to_date_no  | sql_num }} day)
{%- if region %}
  AND region = {{ region | sql_str }}
{%- endif %}
