{# 날짜 fan-out SELECT — task_date(그 task 의 하루)만 조회한다.
   task_column/task_date 는 coordinator 가 날짜별로 주입한다. 컬럼명은 sql_ident,
   날짜 값은 sql_str 로 안전하게 렌더(SQL 인젝션 방지). region 은 있을 때만 조건 추가. #}
SELECT user_id, amount, region, {{ task_column | sql_ident }}
FROM sales
WHERE {{ task_column | sql_ident }} = {{ task_date | sql_str }}
{%- if region %}
  AND region = {{ region | sql_str }}
{%- endif %}
