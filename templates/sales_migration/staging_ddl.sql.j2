{# staging 테이블 생성 DDL(선택). stage_insert 는 이 TEMP 테이블에 COPY 한 뒤 target 으로
   INSERT 한다. coordinator 가 task 마다 staging 이름에 task_id 접미사를 붙여 고유화하고
   (coordinator.stage_unique_staging), task 가 끝나면 DROP 하므로 task 간 격리된다.
   테이블명은 따옴표 없이 bare 로 렌더한다(고유 이름도 같은 자리에 치환됨). #}
CREATE TEMP TABLE {{ staging_table }} (
  user_id  bigint,
  amount   numeric,
  region   text,
  dt       date
)
