[Unit]
# 템플릿 유닛: 인스턴스 이름(%i)을 포트로 사용한다.
#   예) systemctl start query-executor@8001  ->  포트 8001로 기동
Description=Distributed Query Executor (port %i)
Documentation=https://github.com/DataDynamics/distributed-query-executor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=queryexec
Group=queryexec
WorkingDirectory=/opt/query-executor
Environment=QUERY_EXECUTOR_CONFIG_DIR=/etc/query-executor
# 포트는 인스턴스(%i)로 지정. 로그 파일명도 인스턴스별로 분리된다.
Environment=EXECUTOR_PORT=%i
Environment=EXECUTOR_INSTANCE=%i
LogsDirectory=query-executor
# Impala/Greenplum 접속 정보는 /etc/query-executor/config.{properties,yml} 에서 읽는다.
# task 상태를 메모리에 보관하므로 인스턴스(포트)당 단일 워커로 실행한다.
ExecStart=/opt/query-executor/.venv/bin/python -m executor
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

# 보안 강화(hardening)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
