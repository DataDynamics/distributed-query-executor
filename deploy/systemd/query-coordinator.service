[Unit]
Description=Distributed Query Coordinator
Documentation=https://github.com/DataDynamics/distributed-query-executor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=queryexec
Group=queryexec
WorkingDirectory=/opt/query-executor
Environment=QUERY_EXECUTOR_CONFIG_DIR=/etc/query-executor
# /var/log/query-executor 를 생성하고 서비스 계정 소유로 만든다(config.yml 기본 로그 경로).
LogsDirectory=query-executor
# host/port 등은 /etc/query-executor/config.{properties,yml} 에서 읽는다.
# 인메모리 Job 저장소이므로 단일 워커로 실행한다.
ExecStart=/opt/query-executor/.venv/bin/python -m coordinator
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

# 보안 강화(hardening)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
