# Executor 환경설정 (/etc/query-executor/executor.env 로 복사해 사용)
# 주의: 템플릿 유닛에서 포트는 인스턴스 이름(%i)으로 지정하므로 여기에는 PORT를 두지 않는다.

# 바인딩 주소(포트는 systemctl start query-executor@<포트> 로 지정)
HOST=0.0.0.0

# ─────────────────────────────────────────────────────────────
# 실제 Impala/Greenplum 연결용 변수(현재 기본 백엔드는 MockBackend).
# 실연결을 위해서는 executor/app.py 에서 ImpalaToGreenplumBackend를
# 아래 환경변수로 주입하도록 연결하고, requirements-executor.txt 를 설치할 것.
# ─────────────────────────────────────────────────────────────
# IMPALA_HOST=impala-coordinator
# IMPALA_PORT=21050
# GREENPLUM_DSN=postgresql://user:pass@greenplum-master:5432/dbname
# COPY_BATCH_SIZE=10000
