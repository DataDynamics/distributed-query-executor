# Coordinator 환경설정 (/etc/query-executor/coordinator.env 로 복사해 사용)

# 바인딩 주소/포트
HOST=0.0.0.0
PORT=8000

# executor 서비스 URL 목록(쉼표 구분). systemd 인스턴스의 포트와 일치시킬 것.
EXECUTORS=http://127.0.0.1:8001,http://127.0.0.1:8002

# 동시성/타임아웃 (coordinator/config.py 참고)
MAX_CONCURRENT_JOBS=16
MAX_DISPATCH_CONCURRENCY=32
POLL_INTERVAL_S=1.0
TASK_TIMEOUT_S=3600
