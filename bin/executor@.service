# Distributed Query Executor — Executor systemd 유닛(포트별 인스턴스 템플릿)
#
# executor 는 포트마다 하나의 프로세스로 뜬다(인메모리 task 저장소 → 인스턴스당 단일 프로세스).
# 그래서 템플릿 유닛으로 두고 `%i` 에 포트를 넣어 인스턴스를 만든다: executor@8087, executor@8086 …
# config 의 coordinator.executors 목록 포트와 일치시킬 것.
#
#   sudo systemctl link /data1/distributed-query-executor/bin/executor@.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now executor@8087.service          # 8087 인스턴스
#   sudo systemctl enable --now executor@8087 executor@8086    # 여러 포트
#   # 로그·상태:  journalctl -u executor@8087 -f  /  systemctl status executor@8087
#
# HA self-report(멀티 coordinator)를 쓸 때 executor 가 알릴 자기 URL 은 인스턴스별
# EnvironmentFile 로 준다(아래 EnvironmentFile 참고). 단일 coordinator 면 불필요.

[Unit]
Description=Distributed Query Executor - Executor (port %i)
Documentation=file:///data1/distributed-query-executor/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gpadmin
Group=gpadmin
WorkingDirectory=/data1/distributed-query-executor
Environment=QUERY_EXECUTOR_CONFIG_DIR=/data1/distributed-query-executor/config
Environment=PYTHONPATH=/data1/distributed-query-executor/src:/data1/distributed-query-executor
# 인스턴스 식별자 = 수신 포트(%i). 로그 파일명(executor-<port>.log)·task 라우팅에 쓰인다.
Environment=EXECUTOR_PORT=%i
Environment=EXECUTOR_INSTANCE=%i
# 선택(인스턴스별): HA advertise URL 등. 예) 파일에 EXECUTOR_ADVERTISE_URL=http://gp-host:%i
# 파일이 없으면 무시된다('-' 접두사).
EnvironmentFile=-/data1/distributed-query-executor/config/executor@%i.env
ExecStart=/data1/distributed-query-executor/.venv/bin/python -m executor
Restart=on-failure
RestartSec=5
# 종료 시 진행 중 task 를 정리할 시간을 준다(executor.shutdown_drain_timeout_s 기본 25초보다 크게).
KillSignal=SIGTERM
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
