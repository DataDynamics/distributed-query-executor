#!/usr/bin/env bash
# Trino 대화형 SQL 셸. executor 의 query-execute 와 같은 커스텀 실행 함수(query.func.module, 기본
# customs.query_funcs.trino_runner:run)를 같은 설정(query.func.config.*)으로 불러 쿼리를 실행한다.
#
# 명령행으로 준 값이 항상 우선한다.
#   예) trino-shell                                      # 설정대로 실행
#       trino-shell --catalog hive --schema sales        # catalog·schema 만 덮어쓰기
#       trino-shell --password-prompt                    # 비밀번호를 입력받아 넘기기
#       trino-shell --set verify=false                   # 실행 함수 설정 하나 덮어쓰기
#       echo "SELECT 1;" | trino-shell                   # 파이프로 넘겨도 된다
#
# 한 번만 실행하고 끝내려면 모듈을 직접 부른다:
#   PYTHONPATH=src:. python -m tools.trino_query -q "SELECT 1"
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$DIR/.." && pwd)"

# 파이썬: 배포 트리 .venv 우선, 없으면 소스 트리 .venv, 없으면 python3.
# PYTHON 환경변수로 직접 지정할 수도 있다.
if [[ -n "${PYTHON:-}" ]]; then
    PY="$PYTHON"
elif [[ -x "/data1/distributed-query-executor/.venv/bin/python" ]]; then
    PY="/data1/distributed-query-executor/.venv/bin/python"
elif [[ -x "$ROOT/.venv/bin/python" ]]; then
    PY="$ROOT/.venv/bin/python"
else
    PY="$(command -v python3)"
fi

# src 레이아웃이라 src 를, 실행 함수가 최상위 customs 패키지에 있으므로 저장소 루트를 함께 넣는다.
export PYTHONPATH="$ROOT/src:$ROOT${PYTHONPATH:+:$PYTHONPATH}"

# 한글 출력이 크론·파이프에서 깨지지 않게 한다.
export PYTHONIOENCODING="${PYTHONIOENCODING:-utf-8}"

# --help 에 실제로 친 명령 이름이 나오게 한다.
export PROG_NAME="bin/trino-shell"

exec "$PY" -m tools.trino_query --interactive "$@"
