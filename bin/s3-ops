#!/usr/bin/env bash
# S3 객체 조작(업로드·다운로드·복사·이동·삭제·목록·내용 확인).
#
# 버킷과 자격증명은 config/config.properties 의 s3.* 에서 자동으로 읽는다.
# 명령행으로 준 값이 항상 우선한다. s3_stage 가 남긴 스테이징 객체를 확인하거나
# 정리할 때 쓴다.
#   예) s3-ops ls s3://dw-stage/dqe-stage/
#       s3-ops ls dqe-stage/job_abc123/ --summary       # 설정의 기본 버킷 사용
#       s3-ops head s3://dw-stage/dqe-stage/job_abc123/t_0.csv -n 3
#       s3-ops rmdir s3://dw-stage/dqe-stage/ --older-than 7d --yes
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$DIR/.." && pwd)"

# 파이썬: 배포 트리 .venv 우선, 없으면 소스 트리 .venv, 없으면 python3.
# PYTHON 환경변수로 직접 지정할 수도 있다.
if [[ -n "${PYTHON:-}" ]]; then
    PY="$PYTHON"
elif [[ -x "/data1/distributed-query-executor/.venv/bin/python" ]]; then
    PY="/data1/distributed-query-executor/.venv/bin/python"
elif [[ -x "$ROOT/.venv/bin/python" ]]; then
    PY="$ROOT/.venv/bin/python"
else
    PY="$(command -v python3)"
fi

# src 레이아웃이므로 PYTHONPATH 에 src 를 넣어야 tools·core 모듈을 찾는다.
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"

# 크론에서 돌 때를 위한 설정이다. 크론은 LANG 없이 실행되는 경우가 많은데, 그러면
# 파이썬이 출력 인코딩을 ascii 로 잡아 한글을 출력하는 순간 UnicodeEncodeError 로 죽는다.
# 버퍼링을 끄면 출력을 파일로 넘겨도 진행 상황이 제때 보이고 중간에 죽어도 로그가 남는다.
export PYTHONIOENCODING="${PYTHONIOENCODING:-utf-8}"
export PYTHONUNBUFFERED="${PYTHONUNBUFFERED:-1}"

# --help 에 실제로 친 명령 이름이 나오게 한다.
export PROG_NAME="bin/s3-ops"

exec "$PY" -m tools.s3_ops "$@"
