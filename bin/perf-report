#!/usr/bin/env bash
# 성능 지표 로그(*-perf.log) 요약. 시간대별 추이, 병목 의심 구간과 조정 방향, 느린 job/task 를 보여 준다.
#
# 경로를 주지 않으면 config/config.properties 의 logging.dir 아래 지표 파일을 모두 읽는다.
#   예) perf-report                                          # 로그 디렉터리 전체(서비스별로 나눠 출력)
#       perf-report logs/query-executor-8087-perf.log        # 파일 하나
#       perf-report --bucket 1m --since '2026-10-29 09:00'   # 1분 단위, 시각 범위
#       perf-report --keys gp_pool.in_use,rows_written:rate  # 보고 싶은 지표만 표로
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$DIR/.." && pwd)"

# 파이썬: 배포 트리 .venv 우선, 없으면 소스 트리 .venv, 없으면 python3.
# PYTHON 환경변수로 직접 지정할 수도 있다.
if [[ -n "${PYTHON:-}" ]]; then
    PY="$PYTHON"
elif [[ -x "/data1/distributed-query-executor/.venv/bin/python" ]]; then
    PY="/data1/distributed-query-executor/.venv/bin/python"
elif [[ -x "$ROOT/.venv/bin/python" ]]; then
    PY="$ROOT/.venv/bin/python"
else
    PY="$(command -v python3)"
fi

# src 레이아웃이므로 PYTHONPATH 에 src 를 넣어야 tools·core 모듈을 찾는다.
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
# 설정 디렉터리를 따로 주지 않았으면 배포 트리(없으면 소스 트리)의 config 를 읽는다(기본 로그 디렉터리용).
if [[ -z "${QUERY_EXECUTOR_CONFIG_DIR:-}" && ! -d /data1/distributed-query-executor/config && -d "$ROOT/config" ]]; then
    export QUERY_EXECUTOR_CONFIG_DIR="$ROOT/config"
fi

# 한글 출력이 크론·파이프에서 깨지지 않게 한다.
export PYTHONIOENCODING="${PYTHONIOENCODING:-utf-8}"

# --help 에 실제로 친 명령 이름이 나오게 한다.
export PROG_NAME="bin/perf-report"

exec "$PY" -m tools.perf_report "$@"
